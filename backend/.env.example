# Get these from https://developer.spotify.com/dashboard after creating an app
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match the Redirect URI you add in the Spotify Dashboard app settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

PORT=8888

# Random long string, used to sign the state cookie (anti-CSRF)
SESSION_SECRET=change_this_to_something_random
